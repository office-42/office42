e:table-row><table:table-cell office:value-type="string"><text:p>TEXT</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>'TEXT(1234.567,&quot;#,##0.00&quot;)</text:p></table:table-cell><table:table-cell table:formula="of:=TEXT(1234.567;&quot;#,##0.00&quot;)"></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>CONCATENATE</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>'CONCATENATE(B2,&quot; in &quot;,C2)</text:p></table:table-cell><table:table-cell table:formula="of:=CONCATENATE(B2;&quot; in &quot;;C2)"></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>LEFT MID RIGHT</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>'LEFT(B2,3)&amp;MID(B2,2,2)&amp;RIGHT(B2,2)</text:p></table:table-cell><table:table-cell table:formula="of:=LEFT(B2;3)&amp;MID(B2;2;2)&amp;RIGHT(B2;2)"></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>LEN TRIM UPPER</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>'LEN(TRIM(&quot;  a b  &quot;))&amp;UPPER(&quot;x&quot;)</text:p></table:table-cell><table:table-cell table:formula="of:=LEN(TRIM(&quot;  a b  &quot;))&amp;UPPER(&quot;x&quot;)"></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>SUBSTITUTE</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>'SUBSTITUTE(&quot;a-b-c&quot;,&quot;-&quot;,&quot;+&quot;)</text:p></table:table-cell><table:table-cell table:formula="of:=SUBSTITUTE(&quot;a-b-c&quot;;&quot;-&quot;;&quot;+&quot;)"></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>FIND and SEARCH</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>'FIND(&quot;d&quot;,B2)+SEARCH(&quot;D&quot;,B2)</text:p><