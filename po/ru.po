msgstr "Аргумент комплексного числа в радианах."

#: src/formula/o42-fn-engineering.c:539
msgid "The conjugate of a complex number."
msgstr "Число, сопряженное с комплексным числом."

#: src/formula/o42-fn-engineering.c:540
msgid "The cosine of a complex number."
msgstr "Косинус комплексного числа."

#: src/formula/o42-fn-engineering.c:541
msgid "The quotient of two complex numbers."
msgstr "Частное двух комплексных чисел."

#: src/formula/o42-fn-engineering.c:542
msgid "The exponential of a complex number."
msgstr "Экспонента комплексного числа."

#: src/formula/o42-fn-engineering.c:543
msgid "The natural logarithm of a complex number."
msgstr "Натуральный логарифм комплексного числа."

#: src/formula/o42-fn-engineering.c:544
msgid "The base-10 logarithm of a complex number."
msgstr "Десятичный логарифм комплексного числа."

#: src/formula/o42-fn-engineering.c:545
msgid "The base-2 logarithm of a complex number."
msgstr "Двоичный логарифм комплексного числа."

#: src/formula/o42-fn-engineering.c:546
msgid "A complex number raised to a power."
msgstr "Комплексное число, возведенное в степень."

#: src/formula/o42-fn-engineering.c:547
msgid "The product of complex numbers."
msgstr "Произведение комплексных чисел."

#: src/formula/o42-fn-engineering.c:548
msgid "The real part of a complex number."
msgstr "Действительная часть комплексного числа."

#: src/formula/o42-fn-engineering.c:549
msgid "The sine of a complex number."
msgstr "Синус комплексного числа."

#: src/formula/o42-fn-engineering.c:550
msgid "The square root of a complex number."
msgstr "Квадратный корень из комплексного числа."

#: src/formula/o42-fn-engineering.c:551
msgid "The difference of two complex numbers."
msgstr "Разность двух комплексных чисел."

#: src/formula/o42-fn-engineering.c:552
msgid "The sum of complex numbers."
msgstr "Сумма комплексных чисел."

#: src/formula/o42-fn-engineering.c:553
msgid "An octal number as binary."
msgstr "Восьмеричное число в двоичном виде."

#: src/formula/o42-fn-engineering.c:554
msgid "An octal number as decimal."
msgstr "Восьмеричное число в десятичном виде."

#: src/formula/o42-fn-engineering.c:555
msgid "An octal number as hexadecimal."
msgstr "Восьмеричное число в шестнадцатеричном виде."

#: src/formula/o42-fn-finance.c:1355
msgid "Accrued interest on a security that pays periodically."
msgstr "Накопленный доход по ценной бумаге с периодической выплатой процентов."

#: src/formula/o42-fn-finance.c:1356
msgid "Accrued interest on a security that pays at maturity."
msgstr "Накопленный доход по ценной бумаге с выплатой процентов при погашении."

#: src/formula/o42-fn-finance.c:1357
msgid "French degressive depreciation for a period."
msgstr "Французская дегрессивная амортизация за период."

#: src/formula/o42-fn-finance.c:1358
msgid "French straight-line depreciation for a period."
msgstr "Французская линейная амортизация за период."

#: src/formula/o42-fn-finance.c:1359
msgid "A number written out in Thai, in baht and satang."
msgstr "Число прописью на тайском языке, в батах и сатангах."

#: src/formula/o42-fn-finance.c:1360
msgid "Days from the start of the coupon period to the settlement."
msgstr "Число дней от начала купонного периода до даты расчета."

#: src/formula/o42-fn-finance.c:1361
msgid "Days in the coupon period the settlement falls in."
msgstr "Число дней в купонном периоде, содержащем дату расчета."

#: src/formula/o42-fn-finance.c:1362
msgid "Days from the settlement to the next coupon."
msgstr "Число дней от даты расчета до следующего купона."

#: src/formula/o42-fn-finance.c:1363
msgid "The next coupon date after the settlement."
msgstr "Дата следующего купона после даты расчета."

#: src/formula/o42-fn-finance.c:1364
msgid "How many coupons are payable between settlement and maturity."
msgstr ""
"Число купонов, подлежащих выплате между датой расчета и датой погашения."

#: src/formula/o42-fn-finance.c:1365
msgid "The coupon date on or before the settlement."
msgstr "Дата купона, предшествующая дате расчета или совпадающая с ней."

#: src/formula/o42-fn-finance.c:1366
msgid ""
"The time between two dates in years, months or days: \"Y\", \"M\", \"D\", "
"\"YM\", \"YD\", \"MD\"."
msgstr ""
"Интервал между двумя датами в годах, месяцах или днях: \"Y\", \"M\", \"D\", "
"\"YM\", \"YD\", \"MD\"."

#: src/formula/o42-fn-finance.c:1367
msgid "The discount rate of a security."
msgstr "Ставка дисконтирования ценной бумаги."

#: src/formula/o42-fn-finance.c:1368
msgid "A bond's Macaulay duration in years."
msgstr "Дюрация Маколея облигации в годах."

#: src/formula/o42-fn-finance.c:1369
msgid ""
"A sum in one of the euro's member currencies (ISO code) as another, at the "
"fixed rates."
msgstr ""
"Сумма в одной из валют стран еврозоны (код ISO), пересчитанная в другую по "
"фиксированным курсам."

#: src/formula/o42-fn-finance.c:1370
msgid "A principal grown by a series of interest rates."
msgstr "Основная сумма, наращенная по ряду процентных ставок."

#: src/formula/o42-fn-finance.c:1371
msgid "The interest rate of a fully invested security."
msgstr "Процентная ставка полностью инвестированной ценной бумаги."

#: src/formula/o42-fn-finance.c:1372
msgid "The ISO week number of a date."
msgstr "Номер недели даты по ISO."

#: src/formula/o42-fn-finance.c:1373
msgid "A bond's modified duration."
msgstr "Модифицированная дюрация облигации."

#: src/formula/o42-fn-finance.c:1374
msgid "The price of a bond with an odd first period."
msgstr "Цена облигации с нерегулярным первым периодом."

#: src/formula/o42-fn-finance.c:1375
msgid "The yield of a bond with an odd first period."
msgstr "Доходность облигации с нерегулярным первым периодом."

#: src/formula/o42-fn-finance.c:1376
msgid "The price of a bond with an odd last period."
msgstr "Цена облигации с нерегулярным последним периодом."

#: src/formula/o42-fn-finance.c:1377
msgid "The yield of a bond with an odd last period."
msgstr "Доходность облигации с нерегулярным последним периодом."

#: src/formula/o42-fn-finance.c:1378
msgid "The furigana in a cell; the text itself here."
msgstr "Фуригана в ячейке; здесь — сам текст."

#: src/formula/o42-fn-finance.c:1379
msgid "The price per 100 of a bond paying periodic interest."
msgstr ""
"Цена за 100 единиц номинала облигации с периодической выплатой процентов."

#: src/formula/o42-fn-finance.c:1380
msgid "The price per 100 of a discounted security."
msgstr "Цена за 100 единиц номинала дисконтной ценной бумаги."

#: src/formula/o42-fn-finance.c:1381
msgid "The price per 100 of a security paying at maturity."
msgstr ""
"Цена за 100 единиц номинала ценной бумаги с выплатой процентов при погашении."

#: src/formula/o42-fn-finance.c:1382
msgid "What a fully invested security pays at maturity."
msgstr ""
"Сумма, получаемая при погашении полностью инвестированной ценной бумаги."

#: src/formula/o42-fn-finance.c:1383
msgid "A Treasury bill's bond-equivalent yield."
msgstr "Доходность казначейского векселя, эквивалентная доходности облигации."

#: src/formula/o42-fn-finance.c:1384
msgid "The price per 100 of a Treasury bill."
msgstr "Цена за 100 единиц номинала казначейского векселя."

#: src/formula/o42-fn-finance.c:1385
msgid "A Treasury bill's yield."
msgstr "Доходность казначейского векселя."

#: src/formula/o42-fn-finance.c:1386
msgid "The week of the year a date falls in."
msgstr "Номер недели года, на которую приходится дата."

#: src/formula/o42-fn-finance.c:1387
msgid "The fraction of a year between two dates."
msgstr "Доля года между двумя датами."

#: src/formula/o42-fn-finance.c:1388
msgid "The yield of a bond paying periodic interest."
msgstr "Доходность облигации с периодической выплатой процентов."

#: src/formula/o42-fn-finance.c:1389
msgid "The annual yield of a discounted security."
msgstr "Годовая доходность дисконтной ценной бумаги."

#: src/formula/o42-fn-finance.c:1390
msgid "The yield of a security paying at maturity."
msgstr "Доходность ценной бумаги с выплатой процентов при погашении."

#: src/formula/o42-fn-hdate.c:159
msgid "The Hebrew date a serial date falls on, written out."
msgstr "Дата по еврейскому календарю для порядковой даты, прописью."

#: src/formula/o42-fn-hdate.c:160
msgid "The Hebrew date a Gregorian one falls on, written out."
msgstr "Дата по еврейскому календарю для григорианской даты, прописью."

#: src/formula/o42-fn-hdate.c:161
msgid "The serial date a Hebrew date falls on."
msgstr "Порядковая дата, соответствующая дате по еврейскому календарю."

#: src/formula/o42-fn-hdate.c:162
msgid "The Julian day a Hebrew date falls on."
msgstr "Юлианский день, соответствующий дате по еврейскому календарю."

#: src/formula/o42-fn-hdate.c:163
msgid "The day of the Hebrew month."
msgstr "День месяца по еврейскому календарю."

#: src/formula/o42-fn-hdate.c:164
msgid "The Julian day of a Gregorian date."
msgstr "Юлианский день для григорианской даты."

#: src/formula/o42-fn-hdate.c:165
msgid "The Hebrew month, counting Tishri as one."
msgstr "Месяц по еврейскому календарю, считая тишрей первым."

#: src/formula/o42-fn-hdate.c:166
msgid "The Hebrew year."
msgstr "Год по еврейскому календарю."

#: src/formula/o42-fn-info.c:176
msgid ""
"Something about a cell: address, row, col, contents, type, format, width, "
"protect, prefix."
msgstr ""
"Сведения о ячейке: address, row, col, contents, type, format, width, "
"protect, prefix."

#: src/formula/o42-fn-info.c:177
msgid ""
"Something about the program: directory, osversion, recalc, release, system."
msgstr "Сведения о программе: directory, osversion, recalc, release, system."

#: src/formula/o42-fn-options.c:1157
msgid "The American right to swap one asset for another."
msgstr "Американский опцион на обмен одного актива на другой."

#: src/formula/o42-fn-options.c:1158
msgid "Barone-Adesi and Whaley's price for an American option."
msgstr "Цена американского опциона по модели Барони-Адеси — Уэйли."

#: src/formula/o42-fn-options.c:1159
msgid "The price from a binomial tree, American or European."
msgstr "Цена по биномиальному дереву, американский или европейский опцион."

#: src/formula/o42-fn-options.c:1160
msgid "The Black-Scholes price of a European option."
msgstr "Цена европейского опциона по модели Блэка — Шоулза."

#: src/formula/o42-fn-options.c:1161
msgid "How its price moves with the cost of carry."
msgstr "Изменение цены опциона в зависимости от стоимости владения активом."

#: src/formula/o42-fn-options.c:1162
msgid "How its price moves with the spot price."
msgstr "Изменение цены опциона в зависимости от цены спот."

#: src/formula/o42-fn-options.c:1163
msgid "How its delta moves with the spot price."
msgstr "Изменение дельты опциона в зависимости от цены спот."

#: src/formula/o42-fn-options.c:1164
msgid "How its price moves with the interest rate."
msgstr "Изменение цены опциона в зависимости от процентной ставки."

#: src/formula/o42-fn-options.c:1165
msgid "How its price falls as the time runs out."
msgstr "Снижение цены опциона по мере истечения срока."

#: src/formula/o42-fn-options.c:1166
msgid "How its price moves with the volatility."
msgstr "Изменение цены опциона в зависимости от волатильности."

#: src/formula/o42-fn-options.c:1167
msgid "A chooser whose call and put differ in strike and life."
msgstr ""
"Опцион выбора, у которого колл и пут различаются ценой исполнения и сроком."

#: src/formula/o42-fn-options.c:1168
msgid "Margrabe's: the right to swap one asset for another."
msgstr "Модель Маргрейба: право обменять один актив на другой."

#: src/formula/o42-fn-options.c:1169
msgid "An executive option, forfeited at a rate."
msgstr "Опцион для руководителей, аннулируемый с заданной интенсивностью."

#: src/formula/o42-fn-options.c:1170
msgid "An option the writer extends if it expires out of the money."
msgstr "Опцион, который продавец продлевает, если он истекает вне денег."

#: src/formula/o42-fn-options.c:1171
msgid "A lookback settled against a fixed strike."
msgstr "Опцион с оглядкой с фиксированной ценой исполнения."

#: src/formula/o42-fn-options.c:1172
msgid "A lookback settled against the best the spot reached."
msgstr "Опцион с оглядкой, рассчитываемый по лучшей достигнутой цене спот."

#: src/formula/o42-fn-options.c:1173
msgid "An option whose strike is settled later."
msgstr "Опцион, цена исполнения которого устанавливается позже."

#: src/formula/o42-fn-options.c:1174
msgid "French's: the variance counted in trading time."
msgstr "Модель Френча: дисперсия, отсчитываемая в торговом времени."

#: src/formula/o42-fn-options.c:1175
msgid "A currency option."
msgstr "Валютный опцион."

#: src/formula/o42-fn-options.c:1176
msgid "Merton's jump diffusion price."
msgstr "Цена по модели скачкообразной диффузии Мертона."

#: src/formula/o42-fn-options.c:1177
msgid "An option on an option: cc, cp, pc or pp."
msgstr "Опцион на опцион: cc, cp, pc или pp."

#: src/formula/o42-fn-options.c:1178
msgid "Roll, Geske and Whaley's American call on a share paying one dividend."
msgstr ""
"Американский опцион колл на акцию с одной выплатой дивиденда по модели Ролла "
"— Геске — Уэйли."

#: src/formula/o42-fn-options.c:1179
msgid "An option that becomes a call or a put later."
msgstr "Опцион, который позже становится опционом колл или пут."

#: src/formula/o42-fn-options.c:1180
msgid "Kirk's approximation for an option on a spread."
msgstr "Приближение Кирка для опциона на спред."

#: src/formula/o42-fn-options.c:1181
msgid "An option paying for each interval spent in the money."
msgstr "Опцион с выплатой за каждый интервал, проведенный в деньгах."

#: src/formula/o42-fn-random.c:695
msgid "One or nothing, with the given chance of one."
msgstr "Единица или ноль; единица выпадает с заданной вероятностью."

#: src/formula/o42-fn-random.c:696
msgid "A random number from the beta distribution."
msgstr "Случайное число из бета-распределения."

#: src/formula/o42-fn-random.c:697
msgid "How many successes in so many trials."
msgstr "Число успехов в заданном числе испытаний."

#: src/formula/o42-fn-random.c:698
msgid "A random number from Cauchy's distribution."
msgstr "Случайное число из распределения Коши."

#: src/formula/o42-fn-random.c:699
msgid "A random number from the chi-squared distribution."
msgstr "Случайное число из распределения хи-квадрат."

#: src/formula/o42-fn-random.c:700
msgid "One of the values, drawn with the given weights."
msgstr "Одно из значений, выбранное с заданными весами."

#: src/formula/o42-fn-random.c:701
msgid "A random number from the exponential distribution."
msgstr "Случайное число из экспоненциального распределения."

#: src/formula/o42-fn-random.c:702
msgid "A random number from the exponential power distribution."
msgstr "Случайное число из экспоненциально-степенного распределения."

#: src/formula/o42-fn-random.c:703
msgid "A random number from Fisher's F distribution."
msgstr "Случайное число из F-распределения Фишера."

#: src/formula/o42-fn-random.c:704
msgid "A random number from the gamma distribution."
msgstr "Случайное число из гамма-распределения."

#: src/formula/o42-fn-random.c:705
msgid "How many trials until the first success."
msgstr "Число испытаний до первого успеха."

#: src/formula/o42-fn-random.c:706
msgid "A random number from Gumbel's first distribution."
msgstr "Случайное число из распределения Гумбеля первого типа."

#: src/formula/o42-fn-random.c:707
msgid "A random number from Gumbel's second distribution."
msgstr "Случайное число из распределения Гумбеля второго типа."

#: src/formula/o42-fn-random.c:708
msgid "How many of the first kind in a draw from an urn."
msgstr "Число элементов первого вида при выборке из урны."

#: src/formula/o42-fn-random.c:709
msgid "A random number from Laplace's distribution."
msgstr "Случайное число из распределения Лапласа."

#: src/formula/o42-fn-random.c:710
msgid "A random number from Levy's alpha-stable distribution."
msgstr "Случайное число из альфа-устойчивого распределения Леви."

#: src/formula/o42-fn-random.c:711 src/formula/o42-fn-random.c:712
msgid "A random number from the logarithmic distribution."
msgstr "Случайное число из логарифмического распределения."

#: src/formula/o42-fn-random.c:713
msgid "A random number from the logistic distribution."
msgstr "Случайное число из логистического распределения."

#: src/formula/o42-fn-random.c:714
msgid "A random number from the log-normal distribution."
msgstr "Случайное число из логнормального распределения."

#: src/formula/o42-fn-random.c:715
msgid "How many successes before so many failures."
msgstr "Число успехов до заданного числа неудач."

#: src/formula/o42-fn-random.c:716
msgid "A random number from the normal distribution."
msgstr "Случайное число из нормального распределения."

#: src/formula/o42-fn-random.c:717
msgid "A random number from the tail of a normal distribution above a."
msgstr "Случайное число из хвоста нормального распределения выше a."

#: src/formula/o42-fn-random.c:718
msgid "A random number from Pareto's distribution."
msgstr "Случайное число из распределения Парето."

#: src/formula/o42-fn-random.c:719
msgid "A random number from Poisson's distribution."
msgstr "Случайное число из распределения Пуассона."

#: src/formula/o42-fn-random.c:720
msgid "A random number from Rayleigh's distribution."
msgstr "Случайное число из распределения Рэлея."

#: src/formula/o42-fn-random.c:721
msgid "Rayleigh's distribution from a upwards."
msgstr "Распределение Рэлея от a и выше."

#: src/formula/o42-fn-random.c:722 src/formula/o42-fn-random.c:723
msgid "A random number from the standard normal distribution."
msgstr "Случайное число из стандартного нормального распределения."

#: src/formula/o42-fn-random.c:724
msgid "A random number from Student's t distribution."
msgstr "Случайное число из t-распределения Стьюдента."

#: src/formula/o42-fn-random.c:725
msgid "A random number between the two, evenly."
msgstr "Равномерно распределенное случайное число между двумя границами."

#: src/formula/o42-fn-random.c:726
msgid "A random number from Weibull's distribution."
msgstr "Случайное число из распределения Вейбулла."

#: src/formula/o42-fn-statistics.c:638
msgid "The average absolute deviation from the mean."
msgstr "Среднее абсолютное отклонение от среднего."

#: src/formula/o42-fn-statistics.c:639
msgid "The correlation coefficient of two sets."
msgstr "Коэффициент корреляции двух наборов."

#: src/formula/o42-fn-statistics.c:640
msgid "The population covariance of two sets."
msgstr "Ковариация генеральной совокупности для двух наборов."

#: src/formula/o42-fn-statistics.c:641
msgid "The population covariance."
msgstr "Ковариация генеральной совокупности."

#: src/formula/o42-fn-statistics.c:642
msgid "The sum of squared deviations from the mean."
msgstr "Сумма квадратов отклонений от среднего."

#: src/formula/o42-fn-statistics.c:643
msgid "A value on the regression line through known points."
msgstr "Значение на линии регрессии, построенной по известным точкам."

#: src/formula/o42-fn-statistics.c:644
msgid "A value on the regression line through the points."
msgstr "Значение на линии регрессии, построенной по точкам."

#: src/formula/o42-fn-statistics.c:645
msgid "The geometric mean."
msgstr "Среднее геометрическое."

#: src/formula/o42-fn-statistics.c:646
msgid "The harmonic mean."
msgstr "Среднее гармоническое."

#: src/formula/o42-fn-statistics.c:647
msgid "Where the regression line crosses the y axis."
msgstr "Точка пересечения линии регрессии с осью y."

#: src/formula/o42-fn-statistics.c:648
msgid "The k-th largest value."
msgstr "k-е наибольшее значение."

#: src/formula/o42-fn-statistics.c:649 src/formula/o42-fn-statistics.c:650
msgid "The most frequent value."
msgstr "Наиболее часто встречающееся значение."

#: src/formula/o42-fn-statistics.c:651 src/formula/o42-fn-statistics.c:654
msgid "The normal distribution."
msgstr "Нормальное распределение."

#: src/formula/o42-fn-statistics.c:652
msgid "The inverse of the cumulative normal distribution."
msgstr "Обратная функция интегрального нормального распределения."

#: src/formula/o42-fn-statistics.c:653 src/formula/o42-fn-statistics.c:657
msgid "The inverse of the standard normal distribution."
msgstr "Обратное стандартное нормальное распределение."

#: src/formula/o42-fn-statistics.c:655
msgid "The inverse of the normal distribution."
msgstr "Обратное нормальное распределение."

#: src/formula/o42-fn-statistics.c:656
msgid "The standard normal cumulative distribution."
msgstr "Интегральное стандартное нормальное распределение."

#: src/formula/o42-fn-statistics.c:658
msgid "The Pearson correlation coefficient."
msgstr "Коэффициент корреляции Пирсона."

#: src/formula/o42-fn-statistics.c:659
msgid "The value below which a fraction k of the values lie."
msgstr "Значение, ниже которого лежит доля k всех значений."

#: src/formula/o42-fn-statistics.c:660
msgid "The k-th percentile, inclusive."
msgstr "k-я процентиль, включая границы."

#: src/formula/o42-fn-statistics.c:661
msgid "A quartile of the values: 0 to 4."
msgstr "Квартиль значений: от 0 до 4."

#: src/formula/o42-fn-statistics.c:662
msgid "A quartile, inclusive."
msgstr "Квартиль, включая границы."

#: src/formula/o42-fn-statistics.c:663
msgid "The rank of a number among others."
msgstr "Ранг числа среди других чисел."

#: src/formula/o42-fn-statistics.c:664
msgid "The rank of a number in a list."
msgstr "Ранг числа в списке."

#: src/formula/o42-fn-statistics.c:665
msgid "The square of the correlation coefficient."
msgstr "Квадрат коэффициента корреляции."

#: src/formula/o42-fn-statistics.c:666
msgid "The slope of the regression line."
msgstr "Наклон линии регрессии."

#: src/formula/o42-fn-statistics.c:667
msgid "The k-th smallest value."
msgstr "k-е наименьшее значение."

#: src/formula/o42-fn-statistics.c:668
msgid "A value as a number of standard deviations from the mean."
msgstr "Значение, выраженное числом стандартных отклонений от среднего."

#: src/formula/o42-fn-statistics.c:669
msgid "The standard deviation of a sample."
msgstr "Стандартное отклонение по выборке."

#: src/formula/o42-fn-statistics.c:670
msgid "The population standard deviation."
msgstr "Стандартное отклонение генеральной совокупности."

#: src/formula/o42-fn-statistics.c:671
msgid "The sample standard deviation."
msgstr "Выборочное стандартное отклонение."

#: src/formula/o42-fn-statistics.c:672
msgid "The standard deviation of a whole population."
msgstr "Стандартное отклонение всей генеральной совокупности."

#: src/formula/o42-fn-statistics.c:673
msgid "The variance of a sample."
msgstr "Дисперсия по выборке."

#: src/formula/o42-fn-statistics.c:674
msgid "The population variance."
msgstr "Дисперсия генеральной совокупности."

#: src/formula/o42-fn-statistics.c:675
msgid "The sample variance."
msgstr "Выборочная дисперсия."

#: src/formula/o42-fn-statistics.c:676
msgid "The variance of a whole population."
msgstr "Дисперсия всей генеральной совокупности."

#: src/formula/o42-fn-table.c:39
msgid ""
"What a What-If table's formula comes to for this cell; Data > Table writes "
"it."
msgstr ""
"Значение формулы таблицы подстановки для этой ячейки; записывается командой "
"«Данные > Таблица подстановки»."

#: src/formula/o42-fn-text.c:956
msgid "How many characters a text has; the same as LEN here."
msgstr "Число символов в тексте; здесь то же, что LEN."

#: src/formula/o42-fn-text.c:957
msgid "The first characters of a text; the same as LEFT here."
msgstr "Первые символы текста; здесь то же, что LEFT."

#: src/formula/o42-fn-text.c:958
msgid "The last characters of a text; the same as RIGHT here."
msgstr "Последние символы текста; здесь то же, что RIGHT."

#: src/formula/o42-fn-text.c:959
msgid "Characters from the middle of a text; the same as MID here."
msgstr "Символы из середины текста; здесь то же, что MID."

#: src/formula/o42-fn-text.c:960
msgid "Where one text starts inside another; the same as FIND here."
msgstr "Позиция начала одного текста внутри другого; здесь то же, что FIND."

#: src/formula/o42-fn-text.c:961
msgid "Where one text starts inside another; the same as SEARCH here."
msgstr "Позиция начала одного текста внутри другого; здесь то же, что SEARCH."

#: src/formula/o42-fn-text.c:962
msgid "Replaces part of a text by position; the same as REPLACE here."
msgstr "Заменяет часть текста по позиции; здесь то же, что REPLACE."

#: src/formula/o42-fn-text.c:963
msgid "Halfwidth letters, digits and marks made fullwidth."
msgstr "Полуширинные буквы, цифры и знаки, преобразованные в полноширинные."

#: src/formula/o42-fn-text.c:964
msgid ""
"Halfwidth letters, digits and marks made fullwidth; Excel's newer name for "
"JIS."
msgstr ""
"Полуширинные буквы, цифры и знаки, преобразованные в полноширинные; более "
"новое имя JIS в Excel."

#: src/formula/o42-fn-text.c:965
msgid "Fullwidth letters, digits and marks made halfwidth."
msgstr "Полноширинные буквы, цифры и знаки, преобразованные в полуширинные."

#: src/formula/o42-fn-text.c:966
msgid "Whether a regular expression matches somewhere in the text."
msgstr "Есть ли в тексте совпадение с регулярным выражением."

#: src/formula/o42-fn-text.c:967
msgid ""
"The text with what a regular expression matches replaced; \\1 for a group."
msgstr ""
"Текст, в котором совпадения регулярного выражения заменены; \\1 обозначает "
"группу."

#: src/formula/o42-fn-text.c:968
msgid "The sum of a subset as a share of the sum of the whole."
msgstr "Сумма подмножества как доля суммы целого."

#: src/formula/o42-fn-text.c:970
#, no-c-format
msgid "The text as it goes into a URL, %XX for what is not a letter or digit."
msgstr ""
"Текст в виде для URL: %XX вместо всего, что не является буквой или цифрой."

#: src/formula/o42-fn-text.c:971
msgid "How many columns a range spans."
msgstr "Сколько столбцов занимает диапазон."

#: src/formula/o42-fn-text.c:972
msgid "Joins pieces of text into one; Excel's newer name for CONCATENATE."
msgstr ""
"Объединяет фрагменты текста в один; более новое имя CONCATENATE в Excel."

#: src/formula/o42-fn-text.c:973
msgid "Joins pieces of text into one."
msgstr "Объединяет фрагменты текста в один."

#: src/formula/o42-fn-text.c:974
msgid "Where one text starts inside another; case matters."
msgstr "Позиция начала одного текста внутри другого с учетом регистра."

#: src/formula/o42-fn-text.c:975
msgid "The first characters of a text."
msgstr "Первые символы текста."

#: src/formula/o42-fn-text.c:976
msgid "How many characters a text has."
msgstr "Число символов в тексте."

#: src/formula/o42-fn-text.c:977
msgid "Text in lower case."
msgstr "Текст в нижнем регистре."

#: src/formula/o42-fn-text.c:978
msgid "Characters from the middle of a text."
msgstr "Символы из середины текста."

#: src/formula/o42-fn-text.c:979
msgid "A text repeated."
msgstr "Повторенный текст."

#: src/formula/o42-fn-text.c:980
msgid "The last characters of a text."
msgstr "Последние символы текста."

#: src/formula/o42-fn-text.c:981
msgid "How many rows a range spans."
msgstr "Сколько строк занимает диапазон."

#: src/formula/o42-fn-text.c:982
msgid "Replaces old_text with new_text, every time or only the nth."
msgstr "Заменяет old_text на new_text везде или только в n-м вхождении."

#: src/formula/o42-fn-text.c:983
msgid "Text without spaces at the ends, and one between words."
msgstr "Текст без пробелов по краям и с одним пробелом между словами."

#: src/formula/o42-fn-text.c:984
msgid "Text in upper case."
msgstr "Текст в верхнем регистре."

#: src/formula/o42-fn-text.c:985
msgid "Text read as a number."
msgstr "Текст, прочитанный как число."

#: src/formula/o42-fn-text.c:986
msgid "The character with a given code."
msgstr "Символ с заданным кодом."

#: src/formula/o42-fn-text.c:987
msgid "Removes the characters that cannot be printed."
msgstr "Удаляет непечатаемые символы."

#: src/formula/o42-fn-text.c:988
msgid "The code of the first character."
msgstr "Код первого символа."

#: src/formula/o42-fn-text.c:989
msgid "A number as currency text."
msgstr "Число в виде текста в денежном формате."

#: src/formula/o42-fn-text.c:990
msgid "TRUE if two texts are identical, case included."
msgstr "TRUE, если два текста совпадают, включая регистр."

#: src/formula/o42-fn-text.c:991
msgid "A number as text with a fixed number of decimals."
msgstr "Число в виде текста с фиксированным числом десятичных знаков."

#: src/formula/o42-fn-text.c:992
msgid "Text with each word capitalised."
msgstr "Текст, в котором каждое слово начинается с прописной буквы."

#: src/formula/o42-fn-text.c:993
msgid "Replaces part of a text by position."
msgstr "Заменяет часть текста по позиции."

#: src/formula/o42-fn-text.c:994
msgid "Where one text starts inside another; case ignored, wildcards allowed."
msgstr ""
"Позиция начала одного текста внутри другого без учета регистра, с "
"подстановочными знаками."

#: src/formula/o42-fn-text.c:995
msgid "A number as text in a format such as \"#,##0.00\"."
msgstr "Число в виде текста в заданном формате, например \"#,##0.00\"."

