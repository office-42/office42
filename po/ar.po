msgid "Replaces part of a text by position."
msgstr "يستبدل جزءًا من نص حسب الموضع."

#: src/formula/o42-fn-text.c:994
msgid "Where one text starts inside another; case ignored, wildcards allowed."
msgstr ""
"موضع بداية نص داخل نص آخر؛ دون مراعاة حالة الأحرف، مع السماح بأحرف البدل."

#: src/formula/o42-fn-text.c:995
msgid "A number as text in a format such as \"#,##0.00\"."
msgstr "رقم كنص بتنسيق مثل \"#,##0.00\"."

