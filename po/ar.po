#: src/formula/o42-fn-text.c:956
msgid "How many characters a text has; the same as LEN here."
msgstr "عدد أحرف النص؛ مثل LEN هنا."

#: src/formula/o42-fn-text.c:957
msgid "The first characters of a text; the same as LEFT here."
msgstr "الأحرف الأولى من نص؛ مثل LEFT هنا."

#: src/formula/o42-fn-text.c:958
msgid "The last characters of a text; the same as RIGHT here."
msgstr "الأحرف الأخيرة من نص؛ مثل RIGHT هنا."

#: src/formula/o42-fn-text.c:959
msgid "Characters from the middle of a text; the same as MID here."
msgstr "أحرف من وسط نص؛ مثل MID هنا."

#: src/formula/o42-fn-text.c:960
msgid "Where one text starts inside another; the same as FIND here."
msgstr "موضع بداية نص داخل نص آخر؛ مثل FIND هنا."

#: src/formula/o42-fn-text.c:961
msgid "Where one text starts inside another; the same as SEARCH here."
msgstr "موضع بداية نص داخل نص آخر؛ مثل SEARCH هنا."

