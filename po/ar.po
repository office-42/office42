msgid "Text in upper case."
msgstr "النص بأحرف كبيرة."

#: src/formula/o42-fn-text.c:985
msgid "Text read as a number."
msgstr "نص مقروء كرقم."

#: src/formula/o42-fn-text.c:986
msgid "The character with a given code."
msgstr "الحرف ذو رمز معين."

