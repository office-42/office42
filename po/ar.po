msgid "Removes the characters that cannot be printed."
msgstr "يزيل الأحرف غير القابلة للطباعة."

#: src/formula/o42-fn-text.c:988
msgid "The code of the first character."
msgstr "رمز الحرف الأول."

#: src/formula/o42-fn-text.c:989
msgid "A number as currency text."
msgstr "رقم كنص بتنسيق عملة."

