# The message catalogues.  "meson compile office42-pot" refreshes the
# template from POTFILES, and "office42-update-po" the translations.
i18n.gettext(meson.project_name(),
  preset: 'glib',
  args: [
    '--from-code=UTF-8',
    '--package-name=office42',
    '--copyright-holder=The office42 authors',
  ],
)
