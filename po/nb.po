msgid "The first characters of a text."
msgstr "De første tegnene i en tekst."

#: src/formula/o42-fn-text.c:976
msgid "How many characters a text has."
msgstr "Hvor mange tegn en tekst har."

#: src/formula/o42-fn-text.c:977
msgid "Text in lower case."
msgstr "Tekst med små bokstaver."

#: src/formula/o42-fn-text.c:978
msgid "Characters from the middle of a text."
msgstr "Tegn fra midten av en tekst."

#: src/formula/o42-fn-text.c:979
msgid "A text repeated."
msgstr "En tekst gjentatt."

#: src/formula/o42-fn-text.c:980
msgid "The last characters of a text."
msgstr "De siste tegnene i en tekst."

#: src/formula/o42-fn-text.c:981
msgid "How many rows a range spans."
msgstr "Hvor mange rader et område spenner over."

