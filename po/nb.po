msgid ""
"Halfwidth letters, digits and marks made fullwidth; Excel's newer name for "
"JIS."
msgstr ""
"Bokstaver, sifre og tegn i halv bredde gjort om til full bredde; Excels "
"nyere navn på JIS."

#: src/formula/o42-fn-text.c:965
msgid "Fullwidth letters, digits and marks made halfwidth."
msgstr "Bokstaver, sifre og tegn i full bredde gjort om til halv bredde."

