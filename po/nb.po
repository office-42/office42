msgstr "De siste tegnene i en tekst; her det samme som RIGHT."

#: src/formula/o42-fn-text.c:959
msgid "Characters from the middle of a text; the same as MID here."
msgstr "Tegn fra midten av en tekst; her det samme som MID."

